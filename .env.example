# AI provider: gemini (default) or openrouter
AI_PROVIDER=gemini

# Direct Gemini
GEMINI_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_REASONING_EFFORT=medium
OPENROUTER_SITE_URL=https://shuukanhq.com
OPENROUTER_APP_NAME=Kanji Masta

# Server-side Supabase access. Never expose this as a VITE_ variable.
PROD_SUPABASE_SERVICE_ROLE_KEY=
